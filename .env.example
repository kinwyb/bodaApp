# ===== 开发环境（.env.development）=====

# RESTful 接口基础路径。后端接口统一带 /v1/boda 前缀（如登录是 /v1/boda/login）。
# 开发环境保持相对路径，交给 Vite dev server 的 proxy 转发，可绕开跨域问题。
VITE_API_BASE_URL=/v1/boda

# 是否启用本地 mock（仅开发环境生效）。接入线上后端时设为 false
VITE_USE_MOCK=false

# 后端服务地址（仅 Vite dev server 的 proxy 使用）
# VITE_USE_MOCK=false 时，/v1/boda 请求会被转发到此地址
VITE_API_TARGET=http://192.168.9.9:82

# ===== 打包环境（.env.production）=====

# 打包产物由桌面壳以 mygo://localhost/ 载入，没有 dev server 可代理，
# 因此必须写后端绝对地址，不能写 /v1/boda。
# VITE_API_BASE_URL=http://192.168.9.9:82/v1/boda

# ===== 通用（两个环境都可用）=====

# ===== Agent 对话 / 附件 =====

# 后端 ws 服务地址（buibuiCodex 默认 port 8765、path /ws）。留空则走本地演示数据。
# VITE_AGENT_WS_URL=ws://127.0.0.1:8765/ws

# 附件上传/下载端点。**一般不用配**：
# 开发环境默认走 /ws/files（dev server 代理，同源，绕开 CORS 预检）；
# 生产环境由 VITE_AGENT_WS_URL 推导成 http(s)://<host>/ws/files 的绝对地址。
# 只有要指向另一个文件服务时才需要显式指定。
# VITE_AGENT_FILES_URL=/ws/files

# 应用运行环境：debug（开发调试）/ release（正式发布）。
# 统一影响所有「按环境走不同分支」的地方，例如导航菜单按后端菜单节点的
# Debug 还是 Release 标记筛选（见 src/utils/env.ts、src/services/permission.ts）。
# 不填时按构建目标自动推导：dev 走 debug、打包走 release，一般不需要写。
# VITE_APP_ENV=release

# ===== 语音识别（ASR）=====

# 语音转文字服务，代码在仓库 asr/ 目录（SenseVoice + Docker，CPU 即可）。
# 启动：cd asr && docker compose up -d
#
# 开发环境**一般不用配**：前端请求同源的 /asr，由 dev server 代理到 9383。
# 要换目标地址时设 VITE_ASR_TARGET（代理目标，仅开发环境生效）。
# 生产环境没有 dev server，需要用 VITE_ASR_URL 指向实际服务地址。
# VITE_ASR_TARGET=http://127.0.0.1:9383
# VITE_ASR_URL=http://192.168.9.16:9383
