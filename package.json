{
  "name": "bodaway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "app/dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build --config app/vite.config.ts",
    "electron:preview": "npm run build && npm run electron:build && electron .",
    "electron:package": "npm run build && npm run electron:build && electron-builder --config app/electron-builder.yml"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@visactor/vtable": "^1.26.8",
    "@visactor/vtable-plugins": "^1.26.8",
    "@visactor/vtable-search": "^1.26.8",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
