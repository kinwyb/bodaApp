{
  "name": "bodaway",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run menu:descriptions",
    "dev": "vite",
    "prebuild": "npm run menu:descriptions",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test --experimental-strip-types src/components/grid-table/tag.test.ts src/i18n/resolver.test.ts src/pages/agent/protocol/downlink/attachments.test.ts src/pages/agent/protocol/uplink/chat-send.test.ts src/pages/agent/timeline.test.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:import-menu": "node scripts/import-legacy-menu-i18n.mjs",
    "i18n:pages:extract": "node scripts/extract-page-i18n.mjs",
    "i18n:pages:apply": "node scripts/apply-page-i18n.mjs",
    "i18n:pages:generate": "node scripts/generate-page-i18n.mjs",
    "menu:descriptions": "node scripts/sync-menu-descriptions.mjs",
    "menu:descriptions:check": "node scripts/sync-menu-descriptions.mjs --check",
    "preview": "vite preview",
    "app:dev": "mygo dev app",
    "app:build": "mygo build app",
    "gen:api": "node scripts/gen-api-schemas.mjs",
    "file-viewer:setup": "node scripts/setup-file-viewer.mjs",
    "file-viewer:serve": "node scripts/serve-file-viewer.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@visactor/vtable": "^1.26.8",
    "@visactor/vtable-plugins": "^1.26.8",
    "@visactor/vtable-search": "^1.26.8",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "mygo-cli": "^0.3.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
