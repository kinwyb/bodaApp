# 打包环境配置（npm run build，产物由桌面壳内嵌）。
#
# 桌面壳以 mygo://localhost/ 载入页面，没有 dev server 可以代理请求，
# 所以这里必须写后端绝对地址 —— 写 /v1/boda 这类相对路径会被解析到应用自身的源上，必然请求失败。
#
# 后端接口统一带 /v1/boda 前缀。
# ⚠️ 从此处以外的域请求后端属跨域，需要后端在 nginx 上放行 CORS（详见项目说明）。
VITE_API_BASE_URL=http://192.168.9.9:82/v1/boda

# 生产构建下 mock 本就不会生效（见 src/api/request.ts 的 MOCK_ENABLED 判定），
# 这里显式声明，避免以后有人误以为线上还能走 mock 数据。
VITE_USE_MOCK=false

# 应用运行环境：debug（开发调试）/ release（正式发布）。
# 影响所有「按环境走不同分支」的地方，例如导航菜单按 Debug 还是 Release 筛选。
# 不填时按构建目标自动推导 —— 打包产物走 release，只出现标记为已发布的菜单。
# 一般不用写；写了也只是把推导结果显式化。
# VITE_APP_ENV=release
